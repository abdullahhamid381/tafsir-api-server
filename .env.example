# Folder that contains your tafsir editions. Each edition is a folder like
# "adwa-al-bayan" that directly contains surah files (1.json, 2.json, ...)
# and matching surah folders (1/, 2/, ...) with per-ayah files inside.
#
# Two layouts are both supported automatically:
#   data/tafsirs/adwa-al-bayan/...                       (flat: one edition)
#   data/tafsirs/arabic/adwa-al-bayan/...                 (grouped by language)
#   data/tafsirs/english/ibn-kathir/...                   (another language/author)
# The server detects editions by looking for numbered surah files/folders
# (1.json.., 114.json / 1/.. 114/) either directly under DATA_DIR or one
# level down, so you can add more authors and languages later without any
# config changes.
DATA_DIR=./data/tafsirs

# Port the API listens on. Most hosts (Hostinger, Render, etc.) inject this
# themselves - leave it alone in production and only change it for local dev.
PORT=4001

# Host/interface to bind to. 0.0.0.0 is required on most hosts so their
# reverse proxy can reach the app; only change this for local-only testing.
HOST=0.0.0.0

# Comma separated list of allowed CORS origins ("*" allows all)
CORS_ORIGIN=*

# Optional: if set, POST /api/reload requires ?token=<this value>. Leave
# unset to allow reloading without a token (fine for a personal/internal API).
# RELOAD_TOKEN=
